# ── OpenAI (MAYA intelligence engine) ───────────────────────────────────────────
# Required for the MAYA chat API route.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── NextAuth ─────────────────────────────────────────────────────────────────────
# Full URL of your deployment. Must match exactly — mismatch causes HTTP 409.
# Local:      NEXTAUTH_URL=http://localhost:3000
# Production: NEXTAUTH_URL=https://your-vercel-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Random secret for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace-with-a-random-32-byte-hex-string

# ── MAYA user list (invite-only) ─────────────────────────────────────────────────
# JSON array. Generate bcrypt hashes with:
#   node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
MAYA_USERS=[{"id":"u1","name":"Your Name","email":"you@example.com","password":"$2b$12$...bcrypt-hash-here...","org":"Your Org","role":"CEO"}]

# ── Beta gate hardening (optional, recommended in production) ─────────────────────
# Comma-separated invite codes used by /api/beta-validate
# Example: BETA_INVITE_CODES=MAYA-EXEC-1A2B,MAYA-EXEC-3C4D
BETA_INVITE_CODES=
#
# Optional secret used to sign server-side beta access cookies. If omitted,
# MAYA falls back to existing server secrets.
BETA_GATE_SECRET=
#
# Set true to require a valid beta cookie for /api/chat requests.
# Keep false during transition if current users have not re-validated invite code yet.
ENFORCE_BETA_CHAT_GATE=false

# ── Admin dashboard ───────────────────────────────────────────────────────────────
# PIN that gates access to /admin. Change from the default before deploying.
# Example: NEXT_PUBLIC_ADMIN_PIN=YOUR-SECURE-PIN-HERE
NEXT_PUBLIC_ADMIN_PIN=MAYA-ADMIN

# ── Vercel KV (cloud persistence) ────────────────────────────────────────────────
# Required to persist sessions, decisions, vault entries, and beta user data
# across devices and deployments. Without these, data lives in browser
# localStorage only (fine for local dev, not production).
#
# Get these from: Vercel Dashboard → your project → Storage → Create KV Store
# Then copy the values from the .env.local tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Stripe (in-app purchases & source connector subscriptions) ────────────────────
# Required to enable paid source connector add-ons (Westlaw, Bloomberg, etc.)
# Beta users have all connectors included free — Stripe is not required during beta.
#
# Get keys from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Webhook secret — from Stripe Dashboard → Developers → Webhooks → your endpoint
# Local testing: use Stripe CLI  →  stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
#
# Price IDs for source connector add-ons (create Products in Stripe Dashboard first)
# Example: STRIPE_PRICE_WESTLAW=price_1Abc123...
STRIPE_PRICE_WESTLAW=
STRIPE_PRICE_LEXISNEXIS=
STRIPE_PRICE_BLOOMBERG=
STRIPE_PRICE_FACTSET=
STRIPE_PRICE_IEEE=
STRIPE_PRICE_JSTOR=
STRIPE_PRICE_HBR=
STRIPE_PRICE_PITCHBOOK=
